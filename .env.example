LLM_API_KEY=
# 백엔드 (backend/): OpenAI 호출은 팀 에이전트 함수가, Unsplash 는 backend/services/unsplash.py 가 쓴다.
# 키는 이 파일을 .env 로 복사해 넣고, 레포·노션·채팅에는 올리지 않는다. CI 는 키 없이 돈다.
OPENAI_API_KEY=
UNSPLASH_ACCESS_KEY=

# Supabase. SUPABASE_URL 은 https://<프로젝트 ref>.supabase.co (로그인 토큰 검증용, 로컬도 운영 값 사용)
SUPABASE_URL=
# 로컬 개발은 내 PC의 PostgreSQL을 쓴다. 예: postgresql://cardsync:<비밀번호>@127.0.0.1:5432/cardsync_dev
# 운영 Supabase Session pooler 주소는 배포 서버 환경 변수에만 넣는다 (서버 시작 시 진행 중 작업을 실패 처리하므로)
DATABASE_URL=
# 로컬에서 구글 로그인 없이 쓰려면 아무 이름이나 넣는다(예: local-dev). DATABASE_URL 이 localhost·127.0.0.1 일 때만 동작
# 이때 frontend/.env.local 의 VITE_SUPABASE_* 는 비워 두면 로그인 버튼 없이 바로 쓸 수 있다
CARDSYNC_DEV_USER=
# 테스트 전용 DB. 운영 DATABASE_URL 을 넣지 않는다 (테스트가 표를 비운다)
TEST_DATABASE_URL=

# 서버 배포 (docker compose). DOMAIN 은 이 서버 주소, 도메인이 없으면 <공인IP>.sslip.io
DOMAIN=
# 프론트 주소. 여러 개면 쉼표로 구분
CARDSYNC_CORS_ORIGINS=
