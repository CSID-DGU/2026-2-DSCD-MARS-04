LLM_API_KEY=
# 백엔드 (backend/): OpenAI 호출은 팀 에이전트 함수가, Unsplash 는 backend/services/unsplash.py 가 쓴다.
# 키는 이 파일을 .env 로 복사해 넣고, 레포·노션·채팅에는 올리지 않는다. CI 는 키 없이 돈다.
OPENAI_API_KEY=
UNSPLASH_ACCESS_KEY=

# Supabase. SUPABASE_URL 은 https://<프로젝트 ref>.supabase.co, DATABASE_URL 은 Session pooler 연결 문자열
SUPABASE_URL=
DATABASE_URL=
# 테스트 전용 DB. 운영 DATABASE_URL 을 넣지 않는다 (테스트가 표를 비운다)
TEST_DATABASE_URL=

# 서버 배포 (docker compose). DOMAIN 은 이 서버 주소, 도메인이 없으면 <공인IP>.sslip.io
DOMAIN=
# 프론트 주소. 여러 개면 쉼표로 구분
CARDSYNC_CORS_ORIGINS=
